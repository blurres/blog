

    <%- include("./includes/header.ejs") %>

        <main class="blog flex-col">
            <div class="blog-header flex">
                <div class="filters">
                    <form action="/filter">
                        <label for="sort-by">Sort by</label>
                        <select name="sort-by" id="sort-by" class="field">
                            <option value="">default</option>
                            <option value="recent">recent</option>
                            <option value="oldest">oldest</option>
                        </select>
                    </form>
                </div>
                <div class="add-post">
                    <a href="/addPost" class="text-dec-none btn btn-add">New post</a>
                </div>
            </div>
            <div class="blog-posts grid">
                <% posts.forEach((post) => { %>
                    <div class="blog-post flex-col">
                        <img class="blog-image" src="<%= post.image %>" alt="blog-image"/>
                        <div class="blog-info flex-col">
                            <a href="/posts/<%= post.id %>" class="text-dec-none blog-title">
                                <h3 class="blog-title"><%= post.title %></h3>
                            </a>
                            <p class="blog-post-desc"><%= post.description %></p>
                        </div>
                    </div>
                <% }) %>
            </div>
        </main>
        <%- include("./includes/footer.ejs") %>
    </div>
</body>
</html>
<!-- forEach.(key => key) -->

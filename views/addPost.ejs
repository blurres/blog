<%- include("./includes/header.ejs"); %>

<form action="/create" class="add-post-form flex-col" enctype="multipart/form-data">
        <h1 class="add-post-title">Add post</h1>
        <div class="form-group flex-col">
            <label for="post-title">Title</label>
            <input type="text" class="field" id="post-title" required>
        </div>
        <div class="form-group flex-col">
            <label for="post-description">Description</label>
            <textarea name="post-description" id="post-description" class="field" rows="5"></textarea>
        </div>
        <div class="form-group flex-col">
            <label for="post-image">Image / Banner</label>
            <input type="file" name="post-image" id="post-image" class="field">
        </div>
        <div class="form-group flex-col">
            <button class="btn add-post-btn" type="submit">Publish</button>
        </div>
    </form>

    <%- include("./includes/footer.ejs") %>
</body>
</html>

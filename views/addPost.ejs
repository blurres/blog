<%- include("includes/header.ejs"); %>

<form action="/addPost" method="POST" class="add-post-form flex-col">
        <h1 class="add-post-title">Add post</h1>
        <hr>
        <div class="form-group flex-col">
            <label class="peachy" for="post-title">Title</label>
            <input type="text" class="field" id="post-title" name="postTitle"
            placeholder="Post title here..." required>
        </div>
        <div class="form-group flex-col">
            <label class="peachy" for="post-description">Description</label>
            <textarea name="postDescription" id="post-description"
            placeholder="Post description here..."
            class="field" rows="5" required></textarea>
        </div>
        <div class="form-group flex-col">
            <label class="peachy" for="post-image">Image / Banner url</label>
            <input type="text" name="postImageUrl" id="post-image" class="field"
            placeholder="https://www.example.com/my_image.jpg" required>
        </div>
        <div class="form-group flex-col">
            <input class="btn add-post-btn" type="submit" value="Publish">
        </div>
    </form>

    <%- include("includes/footer.ejs") %>
</body>
</html>
